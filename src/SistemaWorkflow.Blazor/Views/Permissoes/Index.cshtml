@{
    ViewData["Title"] = "Matriz de Permissões - BPM";
    var perfis = ViewBag.Perfis as List<SistemaWorkflow.Dominio.Entidades.Perfil> ?? new();
    var permissoes = ViewBag.Permissoes as List<SistemaWorkflow.Dominio.Entidades.Permissao> ?? new();
    var perfilPermissoes = ViewBag.PerfilPermissoes as List<SistemaWorkflow.Dominio.Entidades.PerfilPermissao> ?? new();
}

<div class="mb-4">
    <h2 class="font-weight-bold m-0">Matriz de Privilégios e Perfis</h2>
    <p class="text-muted m-0">Configure os privilégios operacionais de cada perfil de acesso em tempo real.</p>
</div>

<div class="card">
    <div class="card-header bg-transparent">
        <span>Matriz de Direitos de Acesso</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead>
                    <tr>
                        <th class="w-50">Privilégio / Chave do Sistema</th>
                        @foreach (var p in perfis)
                        {
                            <th class="text-center">@p.Nome</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var perm in permissoes.OrderBy(p => p.Nome))
                    {
                        <tr>
                            <td>
                                <strong>@perm.Nome</strong><br />
                                <small class="text-muted"><code>@perm.Chave</code> - @perm.Descricao</small>
                            </td>
                            @foreach (var p in perfis)
                            {
                                var possui = perfilPermissoes.Any(x => x.PerfilId == p.Id && x.PermissaoId == perm.Id && x.Ativo);
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" role="switch" 
                                               @(possui ? "checked" : "") 
                                               onchange="alternarPermissao(this, '@p.Id', '@perm.Id')" />
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="toastFeedback" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">
                Privilégio atualizado com sucesso!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function alternarPermissao(checkbox, perfilId, permissaoId) {
            const associar = checkbox.checked;
            
            // Cria os dados de formulário
            const formData = new FormData();
            formData.append('perfilId', perfilId);
            formData.append('permissaoId', permissaoId);
            formData.append('associar', associar);

            fetch('/Permissoes/Alternar', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                const toastEl = document.getElementById('toastFeedback');
                const toastMsg = document.getElementById('toastMessage');
                const toast = new bootstrap.Toast(toastEl);

                if (data.sucesso) {
                    toastEl.className = 'toast align-items-center text-white bg-success border-0';
                    toastMsg.innerText = 'Matriz de permissão sincronizada com sucesso!';
                } else {
                    toastEl.className = 'toast align-items-center text-white bg-danger border-0';
                    toastMsg.innerText = 'Falha ao atualizar privilégio: ' + data.erro;
                    checkbox.checked = !associar; // Reverte estado se falhar
                }
                toast.show();
            })
            .catch(error => {
                const toastEl = document.getElementById('toastFeedback');
                const toastMsg = document.getElementById('toastMessage');
                const toast = new bootstrap.Toast(toastEl);
                
                toastEl.className = 'toast align-items-center text-white bg-danger border-0';
                toastMsg.innerText = 'Erro de comunicação de rede: ' + error;
                checkbox.checked = !associar; // Reverte estado
                toast.show();
            });
        }
    </script>
}
