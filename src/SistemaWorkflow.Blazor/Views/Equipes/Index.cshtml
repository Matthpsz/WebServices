@model List<SistemaWorkflow.Dominio.Entidades.Equipe>
@{
    ViewData["Title"] = "Gerenciamento de Equipes - BPM";
    var usuarios = ViewBag.Usuarios as List<SistemaWorkflow.Dominio.Entidades.Usuario> ?? new();
}

<div class="mb-4">
    <h2 class="font-weight-bold m-0">Gerenciamento de Setores e Equipes</h2>
    <p class="text-muted m-0">Organize os departamentos corporativos, vincule colaboradores e defina seus respectivos chefes.</p>
</div>

<div class="row">
    <!-- Listagem de Equipes Existentes -->
    <div class="col-md-8">
        @if (!Model.Any())
        {
            <div class="card border-0 py-5 text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-building fs-1 text-primary mb-3"></i>
                    <h5 class="font-weight-bold">Nenhuma Equipe Cadastrada</h5>
                    <p class="text-muted">Comece estruturando seus departamentos corporativos utilizando o painel ao lado.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var e in Model)
            {
                var chefe = e.EquipeUsuarios.FirstOrDefault(eu => eu.AdministradorEquipe && eu.Ativo)?.Usuario?.Nome ?? "Sem Chefe Definido";
                var membros = e.EquipeUsuarios.Where(eu => eu.Ativo).ToList();

                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="m-0 font-weight-bold text-primary">@e.Nome</h5>
                            <small class="text-muted">@e.Descricao</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-circle px-2" title="Editar" onclick="editarEquipe('@e.Id', '@e.Nome', '@e.Descricao')">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form action="/Equipes/Excluir" method="post" onsubmit="return confirm('Deseja realmente desativar esta equipe de trabalho?');">
                                <input type="hidden" name="id" value="@e.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle px-2" title="Remover Equipe">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Membros Atuais -->
                            <div class="col-md-7">
                                <h6 class="font-weight-bold mb-3"><i class="bi bi-people me-2"></i>Membros da Equipe (@membros.Count)</h6>
                                @if (!membros.Any())
                                {
                                    <p class="text-muted small italic">Nenhum colaborador associado a este setor.</p>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush mb-3 border rounded">
                                        @foreach (var m in membros)
                                        {
                                            <div class="list-group-item d-flex align-items-center justify-content-between py-2">
                                                <div>
                                                    <span class="font-weight-medium">@m.Usuario.Nome</span>
                                                    @if (m.AdministradorEquipe)
                                                    {
                                                        <span class="badge bg-danger ms-2"><i class="bi bi-shield-fill"></i> Líder / Chefe</span>
                                                    }
                                                </div>
                                                <form action="/Equipes/RemoverMembro" method="post">
                                                    <input type="hidden" name="id" value="@m.Id" />
                                                    <button type="submit" class="btn btn-link text-danger p-0" title="Desvincular">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Adicionar Membro -->
                            <div class="col-md-5 border-start">
                                <h6 class="font-weight-bold mb-3"><i class="bi bi-person-plus-fill me-2 text-success"></i>Vincular Colaborador</h6>
                                <form action="/Equipes/VincularMembro" method="post">
                                    <input type="hidden" name="equipeId" value="@e.Id" />

                                    <div class="mb-3">
                                        <label class="form-label small font-weight-semibold">Selecionar Usuário</label>
                                        <select class="form-select form-select-sm" name="usuarioId" required>
                                            <option value="">Selecione...</option>
                                            @foreach (var u in usuarios.Where(usr => !membros.Any(m => m.UsuarioId == usr.Id)))
                                            {
                                                <option value="@u.Id">@u.Nome (@u.Email)</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input form-check-input-sm" type="checkbox" name="chefe" value="true" id="chefeCheck_@e.Id" />
                                        <label class="form-check-label small font-weight-semibold" for="chefeCheck_@e.Id">Definir como Chefe de Equipe</label>
                                    </div>

                                    <button type="submit" class="btn btn-success btn-sm w-100 rounded-pill py-2">
                                        <i class="bi bi-plus-lg"></i> Adicionar à Equipe
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Criar / Editar Setor -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" id="formHeader">
                <span><i class="bi bi-plus-circle me-2 text-primary"></i> Novo Departamento/Equipe</span>
            </div>
            <div class="card-body">
                <form action="/Equipes/Salvar" method="post">
                    <input type="hidden" name="id" id="equipeId" value="" />

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Nome do Setor</label>
                        <input type="text" class="form-control" name="nome" id="equipeNome" required placeholder="Ex: Financeiro, Recursos Humanos" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Descrição de Atividades</label>
                        <textarea class="form-control" name="descricao" id="equipeDescricao" rows="3" placeholder="Descreva sucintamente o papel organizacional deste departamento..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary w-50 rounded-pill py-2 d-none" id="btnCancelar" onclick="resetarFormulario()">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2" id="btnSalvar">
                            Cadastrar Equipe
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editarEquipe(id, nome, descricao) {
            document.getElementById('equipeId').value = id;
            document.getElementById('equipeNome').value = nome;
            document.getElementById('equipeDescricao').value = descricao;

            // Altera layout para edição
            document.getElementById('formHeader').innerHTML = '<span><i class="bi bi-pencil-square me-2 text-warning"></i> Editar Equipe</span>';
            document.getElementById('btnSalvar').innerText = 'Salvar Alterações';
            document.getElementById('btnCancelar').classList.remove('d-none');
            document.getElementById('btnSalvar').className = 'btn btn-warning w-100 rounded-pill py-2';
        }

        function resetarFormulario() {
            document.getElementById('equipeId').value = '';
            document.getElementById('equipeNome').value = '';
            document.getElementById('equipeDescricao').value = '';

            // Restaura layout original
            document.getElementById('formHeader').innerHTML = '<span><i class="bi bi-plus-circle me-2 text-primary"></i> Novo Departamento/Equipe</span>';
            document.getElementById('btnSalvar').innerText = 'Cadastrar Equipe';
            document.getElementById('btnCancelar').classList.add('d-none');
            document.getElementById('btnSalvar').className = 'btn btn-primary w-100 rounded-pill py-2';
        }
    </script>
}
