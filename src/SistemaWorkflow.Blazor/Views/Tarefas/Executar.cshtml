@model SistemaWorkflow.Dominio.Entidades.TarefaProcesso
@{
    ViewData["Title"] = "Executar Etapa Operacional";
    var transicoes = ViewBag.Transicoes as List<SistemaWorkflow.Dominio.Entidades.TransicaoAtividade> ?? new();
}

<div class="mb-4">
    <a href="/Tarefas/Fila" class="btn btn-link text-decoration-none p-0 mb-1 d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Voltar à Fila
    </a>
    <h2 class="font-weight-bold m-0">Executar Etapa: @Model.Atividade.Nome</h2>
    <p class="text-muted m-0">Preencha o formulário e tome a decisão operacional correspondente.</p>
</div>

<div class="row">
    <!-- Informações do Processo e Instruções -->
    <div class="col-md-4">
        <div class="card mb-4 bg-light">
            <div class="card-header bg-transparent font-weight-bold">
                <i class="bi bi-info-circle me-2 text-primary"></i> Contexto da Demanda
            </div>
            <div class="card-body">
                <h6 class="font-weight-bold text-primary mb-1">Processo</h6>
                <p class="small mb-3">@Model.Atividade.VersaoProcesso.Processo.Nome</p>

                <h6 class="font-weight-bold text-primary mb-1">Identificador da Instância</h6>
                <p class="small mb-3">@Model.InstanciaProcesso.CodigoIdentificador</p>

                <h6 class="font-weight-bold text-primary mb-1">Data de Abertura</h6>
                <p class="small mb-3">@Model.InstanciaProcesso.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>

                <hr />

                <h6 class="font-weight-bold text-success mb-1"><i class="bi bi-journal-text"></i> Instruções Operacionais</h6>
                <p class="small text-muted mb-0">@(string.IsNullOrEmpty(Model.Atividade.Descricao) ? "Realize o preenchimento dos dados do formulário e encaminhe a tarefa para a próxima etapa." : Model.Atividade.Descricao)</p>
            </div>
        </div>
    </div>

    <!-- Formulário Dinâmico Reativo -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                <span>Formulário de Coleta de Dados</span>
                <span class="badge bg-soft-primary bg-primary text-white">Etapa: @Model.Atividade.Nome</span>
            </div>
            <div class="card-body">
                <form id="tarefaForm" action="/Tarefas/Submeter" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="acaoSelecionada" id="acaoInput" value="" />

                    @if (Model.Atividade.Formulario == null || !Model.Atividade.Formulario.Campos.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-file-earmark-lock fs-3 mb-2"></i>
                            <p>Esta etapa não requer o preenchimento de nenhum formulário. Apenas registre sua decisão operacional abaixo.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var campo in Model.Atividade.Formulario.Campos.OrderBy(c => c.Ordem))
                        {
                            <div class="mb-3">
                                <label class="form-label font-weight-semibold">
                                    @campo.Rotulo
                                    @if (campo.Obrigatorio)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>

                                @if (campo.Tipo == TipoCampoFormulario.Texto)
                                {
                                    <input type="text" class="form-control" name="campo_@campo.Id" @(campo.Obrigatorio ? "required" : "") placeholder="Digite o texto..." />
                                }
                                else if (campo.Tipo == TipoCampoFormulario.AreaTexto)
                                {
                                    <textarea class="form-control" name="campo_@campo.Id" rows="3" @(campo.Obrigatorio ? "required" : "") placeholder="Insira o texto longo..."></textarea>
                                }
                                else if (campo.Tipo == TipoCampoFormulario.Numero)
                                {
                                    <input type="number" class="form-control" name="campo_@campo.Id" @(campo.Obrigatorio ? "required" : "") placeholder="0" />
                                }
                                else if (campo.Tipo == TipoCampoFormulario.Moeda)
                                {
                                    <div class="input-group">
                                        <span class="input-group-text">R$</span>
                                        <input type="number" step="0.01" class="form-control" name="campo_@campo.Id" @(campo.Obrigatorio ? "required" : "") placeholder="0,00" />
                                    </div>
                                }
                                else if (campo.Tipo == TipoCampoFormulario.Data)
                                {
                                    <input type="date" class="form-control" name="campo_@campo.Id" @(campo.Obrigatorio ? "required" : "") />
                                }
                                else if (campo.Tipo == TipoCampoFormulario.Booleano)
                                {
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="campo_@campo.Id" value="true" />
                                        <label class="form-check-label text-muted">Confirmar esta opção</label>
                                    </div>
                                }
                                else if (campo.Tipo == TipoCampoFormulario.UploadArquivo)
                                {
                                    <input type="file" class="form-control" name="campo_@campo.Id" @(campo.Obrigatorio ? "required" : "") />
                                }
                                else if (campo.Tipo == TipoCampoFormulario.Selecao || campo.Tipo == TipoCampoFormulario.SelecaoMultipla)
                                {
                                    <select class="form-select" name="campo_@campo.Id" @(campo.Obrigatorio ? "required" : "") @(campo.Tipo == TipoCampoFormulario.SelecaoMultipla ? "multiple" : "")>
                                        <option value="">Selecione...</option>
                                        @foreach (var op in campo.Opcoes.OrderBy(o => o.Ordem))
                                        {
                                            <option value="@op.Valor">@op.TextoExibicao</option>
                                        }
                                    </select>
                                }
                            </div>
                        }
                    }

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2 flex-wrap">
                        @if (!transicoes.Any())
                        {
                            <!-- Se for etapa final e não houver transições explícitas -->
                            <button type="button" class="btn btn-dark px-4 py-2 rounded-pill shadow-sm" onclick="submeterAcao('Finalizar')">
                                <i class="bi bi-check-all"></i> Finalizar Instância
                            </button>
                        }
                        else
                        {
                            foreach (var tr in transicoes)
                            {
                                string btnClass = tr.Nome.Contains("Reprov") || tr.Nome.Contains("Rejeit") || tr.Nome.Contains("Recus")
                                    ? "btn-danger" 
                                    : tr.Nome.Contains("Aprov") || tr.Nome.Contains("Autoriz") || tr.Nome.Contains("Conclu")
                                    ? "btn-success" 
                                    : "btn-primary";

                                <button type="button" class="btn @btnClass px-4 py-2 rounded-pill shadow-sm" onclick="submeterAcao('@tr.Nome')">
                                    <i class="bi bi-send-fill me-1"></i> @tr.Nome
                                </button>
                            }
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function submeterAcao(acao) {
            document.getElementById('acaoInput').value = acao;
            document.getElementById('tarefaForm').submit();
        }
    </script>
}
