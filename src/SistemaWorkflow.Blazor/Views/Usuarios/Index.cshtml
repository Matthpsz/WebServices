@model List<SistemaWorkflow.Dominio.Entidades.Usuario>
@{
    ViewData["Title"] = "Gerenciamento de Usuários - BPM";
    var perfis = ViewBag.Perfis as List<SistemaWorkflow.Dominio.Entidades.Perfil> ?? new();
}

<div class="mb-4">
    <h2 class="font-weight-bold m-0">Gerenciamento de Colaboradores</h2>
    <p class="text-muted m-0">Cadastre, edite e configure privilégios dos colaboradores e chefes das equipes corporativas.</p>
</div>

<div class="row">
    <!-- Listagem de Colaboradores -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                <span>Contas Corporativas</span>
                <span class="badge bg-light text-dark">Total: @Model.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead>
                            <tr>
                                <th>Nome / E-mail</th>
                                <th>Perfil de Acesso</th>
                                <th>Data Cadastro</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model)
                            {
                                var perfil = u.UsuarioPerfis.FirstOrDefault(up => up.Ativo)?.Perfil?.Nome ?? "Colaborador";
                                
                                <tr>
                                    <td>
                                        <strong>@u.Nome</strong><br />
                                        <small class="text-muted"><i class="bi bi-envelope"></i> @u.Email</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-soft-primary bg-primary text-white">@perfil</span>
                                    </td>
                                    <td>@u.DataCriacao.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (u.Ativo)
                                        {
                                            <span class="badge bg-success">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inativo</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-circle px-2" title="Editar Usuário" onclick="editarUsuario('@u.Id', '@u.Nome', '@u.Email', '@(u.UsuarioPerfis.FirstOrDefault(up => up.Ativo)?.PerfilId)', @(u.Ativo ? "true" : "false") )">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @if (u.Email != "admin@workflow.com.br")
                                            {
                                                <form action="/Usuarios/Excluir" method="post" onsubmit="return confirm('Deseja realmente desativar este colaborador do sistema?');">
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle px-2" title="Desativar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Cadastro / Edição -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header" id="formHeader">
                <span><i class="bi bi-person-plus me-2 text-primary"></i> Cadastrar Novo Colaborador</span>
            </div>
            <div class="card-body">
                <form action="/Usuarios/Salvar" method="post">
                    <input type="hidden" name="id" id="usuarioId" value="" />

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Nome Completo</label>
                        <input type="text" class="form-control" name="nome" id="usuarioNome" required placeholder="Ex: João da Silva" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">E-mail Corporativo</label>
                        <input type="email" class="form-control" name="email" id="usuarioEmail" required placeholder="Ex: joao@empresa.com.br" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold" id="labelSenha">Senha de Acesso</label>
                        <input type="password" class="form-control" name="senha" id="usuarioSenha" required placeholder="Defina uma senha robusta..." />
                        <div class="form-text text-muted" id="ajudaSenha">A senha é obrigatória para cadastros novos.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Perfil / Nível de Acesso</label>
                        <select class="form-select" name="perfilId" id="usuarioPerfil" required>
                            @foreach (var p in perfis)
                            {
                                <option value="@p.Id">@p.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="ativo" value="true" checked id="usuarioAtivo" />
                        <label class="form-check-label font-weight-medium" for="usuarioAtivo">Colaborador Ativo</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary w-50 rounded-pill py-2 d-none" id="btnCancelar" onclick="resetarFormulario()">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2" id="btnSalvar">
                            Cadastrar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editarUsuario(id, nome, email, perfilId, ativo) {
            document.getElementById('usuarioId').value = id;
            document.getElementById('usuarioNome').value = nome;
            document.getElementById('usuarioEmail').value = email;
            document.getElementById('usuarioPerfil').value = perfilId;
            document.getElementById('usuarioAtivo').checked = ativo;

            // Altera layout para edição
            document.getElementById('formHeader').innerHTML = '<span><i class="bi bi-pencil-square me-2 text-warning"></i> Editar Colaborador</span>';
            document.getElementById('btnSalvar').innerText = 'Salvar Alterações';
            document.getElementById('btnCancelar').classList.remove('d-none');
            document.getElementById('btnSalvar').className = 'btn btn-warning w-100 rounded-pill py-2';
            
            // Senha opcional na edição
            document.getElementById('usuarioSenha').required = false;
            document.getElementById('ajudaSenha').innerText = 'Deixe em branco para manter a senha atual.';
        }

        function resetarFormulario() {
            document.getElementById('usuarioId').value = '';
            document.getElementById('usuarioNome').value = '';
            document.getElementById('usuarioEmail').value = '';
            document.getElementById('usuarioSenha').value = '';
            document.getElementById('usuarioAtivo').checked = true;

            // Restaura layout original
            document.getElementById('formHeader').innerHTML = '<span><i class="bi bi-person-plus me-2 text-primary"></i> Cadastrar Novo Colaborador</span>';
            document.getElementById('btnSalvar').innerText = 'Cadastrar';
            document.getElementById('btnCancelar').classList.add('d-none');
            document.getElementById('btnSalvar').className = 'btn btn-primary w-100 rounded-pill py-2';
            
            // Senha obrigatória para novo cadastro
            document.getElementById('usuarioSenha').required = true;
            document.getElementById('ajudaSenha').innerText = 'A senha é obrigatória para cadastros novos.';
        }
    </script>
}
