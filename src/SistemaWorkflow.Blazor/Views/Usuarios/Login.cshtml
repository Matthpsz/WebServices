@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Workflow & BPM Corporativo</title>
    
    <!-- Bootstrap 5 & Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            --card-bg: rgba(30, 41, 59, 0.7);
            --border-color: rgba(255, 255, 255, 0.08);
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --primary-color: #3b82f6;
            --primary-hover: #2563eb;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-gradient);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow-x: hidden;
            position: relative;
        }

        /* Abstract glowing background circles */
        .glowing-circle {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.15;
            z-index: 1;
        }
        .circle-1 {
            width: 400px;
            height: 400px;
            background: #3b82f6;
            top: -100px;
            left: -100px;
        }
        .circle-2 {
            width: 500px;
            height: 500px;
            background: #4f46e5;
            bottom: -150px;
            right: -100px;
        }

        .login-container {
            width: 100%;
            max-width: 460px;
            padding: 1.5rem;
            position: relative;
            z-index: 10;
        }

        .login-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
        }

        .logo-area {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--primary-color) 0%, #4f46e5 100%);
            color: white;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 8px 20px -6px rgba(59, 130, 246, 0.5);
        }

        .form-control {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border-color);
            color: #fff;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            transition: all 0.2s ease;
        }
        .form-control:focus {
            background: rgba(15, 23, 42, 0.8);
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
            color: #fff;
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .btn-login {
            background: linear-gradient(135deg, var(--primary-color) 0%, #4f46e5 100%);
            border: none;
            color: white;
            border-radius: 12px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            box-shadow: 0 8px 20px -6px rgba(59, 130, 246, 0.4);
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -6px rgba(59, 130, 246, 0.6);
            background: linear-gradient(135deg, #2563eb 0%, #4338ca 100%);
        }
        .btn-login:active {
            transform: translateY(0);
        }

        /* Accounts Quick Selection */
        .quick-accounts-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 1.25rem;
            margin-top: 1.5rem;
        }
        .quick-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--text-color);
            border-radius: 8px;
            padding: 0.4rem 0.6rem;
            font-size: 0.75rem;
            font-weight: 500;
            transition: all 0.15s ease;
            text-align: left;
            width: 100%;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .quick-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateX(2px);
        }
        .quick-role {
            font-size: 0.7rem;
            opacity: 0.6;
        }
    </style>
</head>
<body>

    <!-- Circles background -->
    <div class="glowing-circle circle-1"></div>
    <div class="glowing-circle circle-2"></div>

    <div class="login-container">
        <div class="login-card">
            <div class="text-center">
                <div class="logo-area">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <h4 class="fw-bold mb-1">BPM Workflow</h4>
                <p class="text-secondary small mb-4">Gerenciamento de Processos Corporativos</p>
            </div>

            <!-- Feedback de Alertas -->
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger border-0 small rounded-3 mb-4 d-flex align-items-center gap-2" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["Erro"]</span>
                </div>
            }
            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success border-0 small rounded-3 mb-4 d-flex align-items-center gap-2" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["Sucesso"]</span>
                </div>
            }

            <form asp-action="Logar" method="post">
                <div class="mb-3">
                    <label for="email" class="form-label">E-mail Corporativo</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="ex: matheus@workflow.com.br" required autocomplete="email" />
                </div>
                
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="senha" class="form-label mb-0">Senha de Acesso</label>
                    </div>
                    <input type="password" class="form-control" id="senha" name="senha" placeholder="Digite sua senha..." required />
                </div>

                <button type="submit" class="btn btn-login w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                    <span>Acessar o Painel</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <!-- Quick Selection panel for user testing convenience -->
            <div class="quick-accounts-card">
                <h6 class="text-secondary fw-bold text-uppercase mb-2" style="font-size: 0.65rem; letter-spacing: 0.05em;">
                    🚀 Clique para Auto-Preencher Contas de Teste
                </h6>
                <div class="d-flex flex-column gap-1">
                    <button type="button" class="quick-btn" onclick="preencher('admin@workflow.com.br', 'Admin@1234')">
                        <span>admin@workflow.com.br</span>
                        <span class="badge bg-primary rounded-pill quick-role">Admin</span>
                    </button>
                    <button type="button" class="quick-btn" onclick="preencher('matheus@workflow.com.br', 'Admin@1234')">
                        <span>matheus@workflow.com.br</span>
                        <span class="badge bg-primary rounded-pill quick-role">Matheus (Admin)</span>
                    </button>
                    <button type="button" class="quick-btn" onclick="preencher('ana.souza@workflow.com.br', 'Admin@1234')">
                        <span>ana.souza@workflow.com.br</span>
                        <span class="badge bg-info text-dark rounded-pill quick-role">Ana (Gestor)</span>
                    </button>
                    <button type="button" class="quick-btn" onclick="preencher('lucas.lima@workflow.com.br', 'Admin@1234')">
                        <span>lucas.lima@workflow.com.br</span>
                        <span class="badge bg-secondary rounded-pill quick-role">Lucas (Colaborador)</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function preencher(email, senha) {
            document.getElementById('email').value = email;
            document.getElementById('senha').value = senha;
            
            // Subtle pulse focus animation
            const emailInput = document.getElementById('email');
            emailInput.focus();
            setTimeout(() => {
                document.getElementById('senha').focus();
            }, 150);
        }
    </script>
</body>
</html>
