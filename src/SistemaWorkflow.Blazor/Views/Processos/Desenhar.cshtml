@model SistemaWorkflow.Dominio.Entidades.VersaoProcesso
@{
    ViewData["Title"] = "Modelador de Workflow / BPM";
    var equipes = ViewBag.Equipes as List<SistemaWorkflow.Dominio.Entidades.Equipe> ?? new();
    var formularios = ViewBag.Formularios as List<SistemaWorkflow.Dominio.Entidades.Formulario> ?? new();
    var transicoes = ViewBag.Transicoes as List<SistemaWorkflow.Dominio.Entidades.TransicaoAtividade> ?? new();
    bool ehRascunho = Model.Status == StatusVersaoProcesso.Rascunho;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a href="/Processos" class="btn btn-link text-decoration-none p-0 mb-1 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Voltar aos Processos
        </a>
        <h2 class="font-weight-bold m-0">Desenhar Fluxo: @Model.Processo.Nome</h2>
        <p class="text-muted m-0">Modelagem visual das etapas, SLAs, responsabilidades e transições do processo.</p>
    </div>
    <div>
        <span class="badge bg-soft-info bg-info text-white px-3 py-2 fs-6 rounded-pill">
            Versão #@Model.NumeroVersao - @(Model.Status == StatusVersaoProcesso.Ativo ? "Homologado (Produção)" : "Rascunho (Edição)")
        </span>
    </div>
</div>

<div class="row">
    <!-- Painel de Controles -->
    <div class="col-md-5">
        @if (ehRascunho)
        {
            <!-- Adicionar Etapa (Atividade) -->
            <div class="card mb-4">
                <div class="card-header bg-transparent">
                    <span><i class="bi bi-node-plus me-2 text-primary"></i> 1. Adicionar Etapa Operacional</span>
                </div>
                <div class="card-body">
                    <form action="/Processos/AdicionarAtividade" method="post">
                        <input type="hidden" name="versaoProcessoId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label font-weight-semibold">Nome da Etapa</label>
                            <input type="text" class="form-control" name="nome" required placeholder="Ex: Análise de Crédito, Faturamento" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-semibold">Instruções para o Executor</label>
                            <textarea class="form-control" name="descricao" rows="2" placeholder="Descreva o que o executor deve fazer nesta etapa..."></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-semibold">Prazo SLA (Minutos)</label>
                                <input type="number" class="form-control" name="SlaMinutos" value="120" min="1" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-semibold">Formulário Requerido</label>
                                <select class="form-select" name="formularioId">
                                    <option value="">Nenhum formulário...</option>
                                    @foreach (var f in formularios)
                                    {
                                        <option value="@f.Id">@f.Nome</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-semibold">Equipe Responsável</label>
                            <select class="form-select" name="responsavelEquipeId">
                                <option value="">Executor da etapa anterior (Geral)</option>
                                @foreach (var e in equipes)
                                {
                                    <option value="@e.Id">@e.Nome</option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ehInicial" value="true" id="ehInicialCheck" />
                                    <label class="form-check-label font-weight-medium" for="ehInicialCheck">Etapa Inicial</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ehFinal" value="true" id="ehFinalCheck" />
                                    <label class="form-check-label font-weight-medium" for="ehFinalCheck">Etapa Final</label>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                            <i class="bi bi-plus-lg"></i> Adicionar Etapa ao Fluxo
                        </button>
                    </form>
                </div>
            </div>

            <!-- Adicionar Transição (Conexão) -->
            <div class="card">
                <div class="card-header bg-transparent">
                    <span><i class="bi bi-arrow-right-circle me-2 text-success"></i> 2. Conectar Etapas (Transição de Fluxo)</span>
                </div>
                <div class="card-body">
                    <form action="/Processos/AdicionarTransicao" method="post">
                        <input type="hidden" name="versaoProcessoId" value="@Model.Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-semibold">Etapa de Origem</label>
                                <select class="form-select" name="origemId" required>
                                    <option value="">Selecione...</option>
                                    @foreach (var a in Model.Atividades.Where(x => x.Ativo).OrderBy(x => x.Nome))
                                    {
                                        <option value="@a.Id">@a.Nome</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-semibold">Etapa de Destino</label>
                                <select class="form-select" name="destinoId" required>
                                    <option value="">Selecione...</option>
                                    @foreach (var a in Model.Atividades.Where(x => x.Ativo).OrderBy(x => x.Nome))
                                    {
                                        <option value="@a.Id">@a.Nome</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-semibold">Ação do Botão (Nome do Gatilho)</label>
                            <input type="text" class="form-control" name="nomeAcao" required placeholder="Ex: Aprovar, Reprovar, Reenviar" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-semibold">Condição de Encaminhamento (Opcional)</label>
                            <input type="text" class="form-control" name="condicao" placeholder="Ex: Valor > 5000" />
                        </div>

                        <button type="submit" class="btn btn-success w-100 rounded-pill py-2">
                            <i class="bi bi-shuffle"></i> Conectar Transição
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 py-4 text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-patch-check fs-1 text-success mb-3"></i>
                    <h5 class="font-weight-bold">Fluxo Homologado e Publicado</h5>
                    <p class="text-muted">Esta versão do processo está atualmente em produção. Alterações ou adições de etapas não são permitidas para preservar a integridade das instâncias em execução.</p>
                    <a href="/Processos" class="btn btn-outline-primary rounded-pill">Voltar</a>
                </div>
            </div>
        }
    </div>

    <!-- Mapa Visual e Lista de Conexões -->
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span>Mapa de Etapas Mapeadas</span>
                <span class="badge bg-light text-dark">Total: @Model.Atividades.Count etapas</span>
            </div>
            <div class="card-body">
                @if (!Model.Atividades.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-bezier2 fs-1 mb-2"></i>
                        <p>Nenhuma etapa cadastrada no rascunho. Comece criando a etapa inicial.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3 p-3 bg-light rounded-3" style="max-height: 500px; overflow-y: auto;">
                        @foreach (var a in Model.Atividades.OrderBy(x => x.EhInicial ? 0 : x.EhFinal ? 2 : 1).ThenBy(x => x.Nome))
                        {
                            <div class="card border shadow-sm m-0 p-3 bg-white" style="border-left: 5px solid @(a.EhInicial ? "#198754" : a.EhFinal ? "#212529" : "#3b82f6") !important;">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="m-0 font-weight-bold">@a.Nome</h6>
                                        <small class="text-muted d-block mt-1">SLA: @a.SlaMinutos minutos | Formulário: @(a.Formulario?.Nome ?? "Nenhum")</small>
                                        <small class="text-muted d-block mt-1">Responsável: @(a.ResponsavelEquipe?.Nome ?? "Executor anterior")</small>
                                    </div>
                                    <div>
                                        @if (a.EhInicial)
                                        {
                                            <span class="badge bg-success">Início</span>
                                        }
                                        else if (a.EhFinal)
                                        {
                                            <span class="badge bg-dark">Fim</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Intermediária</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span>Transições Configuradas (Fluxo Direcional)</span>
            </div>
            <div class="card-body p-0">
                @if (!transicoes.Any())
                {
                    <div class="text-center py-4 text-muted small">Nenhuma transição criada para conectar as etapas.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle m-0 small">
                            <thead>
                                <tr>
                                    <th>Origem</th>
                                    <th>Ação (Botão)</th>
                                    <th>Destino</th>
                                    <th>Condição</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in transicoes)
                                {
                                    <tr>
                                        <td><strong>@t.AtividadeOrigem.Nome</strong></td>
                                        <td><span class="badge bg-light text-success border">@t.Nome</span></td>
                                        <td><strong>@t.AtividadeDestino.Nome</strong></td>
                                        <td><code class="text-muted">@(string.IsNullOrEmpty(t.Condicao) ? "Sempre" : t.Condicao)</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
