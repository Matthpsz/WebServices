@model List<SistemaWorkflow.Dominio.Entidades.Processo>
@{
    ViewData["Title"] = "Processos Mapeados - BPM";
    var equipes = ViewBag.Equipes as List<SistemaWorkflow.Dominio.Entidades.Equipe> ?? new();
    var instanciasContagem = ViewBag.InstanciasContagem as Dictionary<Guid, int> ?? new();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="font-weight-bold m-0">Processos Corporativos Mapeados</h2>
        <p class="text-muted m-0">Consulte a listagem de processos homologados, suas versões ativas e donos.</p>
    </div>
    <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovoProcesso">
        <i class="bi bi-plus-lg"></i> Novo Processo
    </button>
</div>

<!-- KPIs Simplificados de Processos -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card p-3 border-0 bg-white text-dark shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <span class="small font-weight-bold text-uppercase text-muted">Total de Processos</span>
                <i class="bi bi-diagram-3 fs-3 text-primary"></i>
            </div>
            <h3 class="font-weight-bold m-0 mt-2">@Model.Count</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-0 bg-white text-dark shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <span class="small font-weight-bold text-uppercase text-muted">Versões Homologadas</span>
                <i class="bi bi-patch-check fs-3 text-success"></i>
            </div>
            <h3 class="font-weight-bold m-0 mt-2">@ViewBag.VersoesAtivasContagem</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-0 bg-white text-dark shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <span class="small font-weight-bold text-uppercase text-muted">Instâncias em Andamento</span>
                <i class="bi bi-clock-history fs-3 text-warning"></i>
            </div>
            <h3 class="font-weight-bold m-0 mt-2">@ViewBag.InstanciasAtivasContagem</h3>
        </div>
    </div>
</div>

<!-- Listagem Completa de Processos -->
<div class="card">
    <div class="card-header bg-transparent">
        <span>Definições Corporativas</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-bezier2 fs-1 mb-2"></i>
                <p>Nenhum processo estruturado ainda.</p>
                <button class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#modalNovoProcesso">
                    Cadastrar Primeiro Processo
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>Código/ID</th>
                            <th>Nome do Processo</th>
                            <th>Equipe Proprietária</th>
                            <th>Versão Ativa</th>
                            <th>Total de Etapas</th>
                            <th>Instâncias</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var versaoAtiva = p.Versoes.FirstOrDefault(v => v.Status == StatusVersaoProcesso.Ativo);
                            var rascunho = p.Versoes.FirstOrDefault(v => v.Status == StatusVersaoProcesso.Rascunho);
                            int totalInstancias = instanciasContagem.TryGetValue(p.Id, out var qtd) ? qtd : 0;

                            <tr>
                                <td><code>@p.Id.ToString().Substring(0, 8).ToUpper()</code></td>
                                <td>
                                    <strong>@p.Nome</strong><br />
                                    <small class="text-muted">@p.Descricao</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(p.Equipe?.Nome ?? "Geral / Corporativo")
                                    </span>
                                </td>
                                <td>
                                    @if (versaoAtiva != null)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Versão #@versaoAtiva.NumeroVersao</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Sem Versão Ativa</span>
                                    }
                                </td>
                                <td>
                                    @(versaoAtiva?.Atividades.Count ?? 0) etapas
                                </td>
                                <td>
                                    <span class="font-weight-medium">@totalInstancias iniciadas</span>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Gerenciar
                                        </button>
                                        <ul class="dropdown-menu">
                                            @if (rascunho != null)
                                            {
                                                <li>
                                                    <a class="dropdown-item" href="/Processos/Desenhar?versaoId=@rascunho.Id">
                                                        <i class="bi bi-pencil-square"></i> Editar Rascunho (#@rascunho.NumeroVersao)
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <form action="/Processos/CriarNovaVersao" method="post">
                                                        <input type="hidden" name="processoId" value="@p.Id" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-plus-circle"></i> Criar Nova Versão (Rascunho)
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            @if (versaoAtiva != null)
                                            {
                                                <li>
                                                    <a class="dropdown-item" href="/Processos/Desenhar?versaoId=@versaoAtiva.Id">
                                                        <i class="bi bi-eye"></i> Visualizar Fluxo Ativo
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Novo Processo -->
<div class="modal fade" id="modalNovoProcesso" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">Mapear Novo Processo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Processos/CriarNovo" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Nome do Processo</label>
                        <input type="text" class="form-control" name="nome" required placeholder="Ex: Solicitação de Compras, Admissão" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Descrição do Escopo</label>
                        <textarea class="form-control" name="descricao" rows="3" placeholder="Descreva brevemente o escopo operacional deste processo..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Equipe Gestora / Proprietária</label>
                        <select class="form-select" name="equipeId" required>
                            <option value="">Selecione a equipe responsável...</option>
                            @foreach (var e in equipes)
                            {
                                <option value="@e.Id">@e.Nome</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Avançar para Fluxo</button>
                </div>
            </form>
        </div>
    </div>
</div>
