@model SistemaWorkflow.Dominio.Entidades.VersaoProcesso
@{
    ViewData["Title"] = "Auditoria de Fluxo do Processo";
}

<div class="mb-4">
    <a href="/Processos/Homologacoes" class="btn btn-link text-decoration-none p-0 mb-1 d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Voltar às Homologações
    </a>
    <h2 class="font-weight-bold m-0">Auditoria de Processo: @Model.Processo.Nome</h2>
    <p class="text-muted m-0">Avalie todas as etapas operacionais, responsabilidades e SLAs antes de autorizar a entrada em produção.</p>
</div>

<div class="row">
    <!-- Etapas sob Auditoria -->
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header bg-transparent">
                <span>Estrutura de Etapas Mapeadas</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0 small">
                        <thead>
                            <tr>
                                <th>Nome da Etapa</th>
                                <th>SLA</th>
                                <th>Tipo</th>
                                <th>Formulário</th>
                                <th>Equipe Responsável</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Atividades.Where(x => x.Ativo).OrderBy(x => x.EhInicial ? 0 : x.EhFinal ? 2 : 1))
                            {
                                <tr>
                                    <td>
                                        <strong>@a.Nome</strong><br />
                                        <small class="text-muted">@a.Descricao</small>
                                    </td>
                                    <td>@a.SlaMinutos minutos</td>
                                    <td>
                                        @if (a.EhInicial)
                                        {
                                            <span class="badge bg-success">Início</span>
                                        }
                                        else if (a.EhFinal)
                                        {
                                            <span class="badge bg-dark">Fim</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Intermediária</span>
                                        }
                                    </td>
                                    <td>@(a.Formulario?.Nome ?? "Nenhum")</td>
                                    <td>@(a.ResponsavelEquipe?.Nome ?? "Executor anterior")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário de Homologação -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <span>Decisão de Validação Corporativa</span>
            </div>
            <div class="card-body">
                <form action="/Processos/Homologar" method="post">
                    <input type="hidden" name="versaoId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Parecer do Auditor</label>
                        <select class="form-select" name="aprovado" required>
                            <option value="true">APROVAR E PUBLICAR EM PRODUÇÃO</option>
                            <option value="false">REJEITAR E RETORNAR PARA AJUSTES</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Justificativa da Decisão</label>
                        <textarea class="form-control" name="justificativa" rows="5" required placeholder="Insira considerações de negócio ou justificativa da homologação técnica..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                        <i class="bi bi-shield-check"></i> Registrar Decisão
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
