@model SistemaWorkflow.Dominio.Entidades.Formulario
@{
    ViewData["Title"] = "Form Builder - Construtor de Formulários";
    var formularios = ViewBag.Formularios as List<SistemaWorkflow.Dominio.Entidades.Formulario> ?? new();
}

<div class="mb-4">
    <h2 class="font-weight-bold m-0">Construtor de Formulários Dinâmicos</h2>
    <p class="text-muted m-0">Crie modelos de formulários reativos para coletar dados nas etapas operacionais de BPM.</p>
</div>

<div class="row">
    <!-- Formulários Criados -->
    <div class="col-md-3">
        <div class="card">
            <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                <span>Modelos Existentes</span>
                <button class="btn btn-primary btn-sm rounded-circle" data-bs-toggle="modal" data-bs-target="#modalNovoForm" title="Novo Formulário">
                    <i class="bi bi-plus"></i>
                </button>
            </div>
            <div class="list-group list-group-flush">
                @if (!formularios.Any())
                {
                    <div class="text-center py-4 text-muted small">Nenhum formulário cadastrado.</div>
                }
                else
                {
                    foreach (var f in formularios)
                    {
                        <a href="/Formularios/Criar/@f.Id" class="list-group-item list-group-item-action py-3 @(Model?.Id == f.Id ? "active bg-primary text-white" : "")">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <h6 class="mb-1 font-weight-bold">@f.Nome</h6>
                            </div>
                            <small class="@(Model?.Id == f.Id ? "text-white-50" : "text-muted")">@f.Descricao</small>
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Construtor e Visualização -->
    <div class="col-md-9">
        @if (Model == null)
        {
            <div class="card border-0 py-5 text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-file-earmark-ruled fs-1 text-primary mb-3"></i>
                    <h5 class="font-weight-bold">Selecione ou Crie um Formulário</h5>
                    <p class="text-muted">Selecione um formulário na lista lateral ou clique no botão de soma para começar a estruturar campos.</p>
                    <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovoForm">
                        <i class="bi bi-plus-lg"></i> Criar Novo Formulário
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <!-- Adicionar Campos -->
                <div class="col-md-5">
                    <div class="card">
                        <div class="card-header">
                            <span><i class="bi bi-plus-square me-2 text-primary"></i>Adicionar Novo Campo</span>
                        </div>
                        <div class="card-body">
                            <form action="/Formularios/AdicionarCampo" method="post">
                                <input type="hidden" name="formularioId" value="@Model.Id" />
                                
                                <div class="mb-3">
                                    <label class="form-label font-weight-semibold">Nome/Rótulo do Campo</label>
                                    <input type="text" class="form-control" name="label" required placeholder="Ex: Nome Completo, Valor da Compra" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label font-weight-semibold">Tipo do Campo</label>
                                    <select class="form-select" name="tipo" id="campoTipo" onchange="alternarOpcoesSelect()">
                                        <option value="Texto">Texto Curto</option>
                                        <option value="AreaTexto">Texto Longo (Caixa)</option>
                                        <option value="Numero">Inteiro / Numérico</option>
                                        <option value="Moeda">Valor Monetário (R$)</option>
                                        <option value="Data">Data</option>
                                        <option value="Selecao">Seleção de Opção (Dropdown)</option>
                                        <option value="SelecaoMultipla">Seleção Múltipla</option>
                                        <option value="Booleano">Sim / Não (Checkbox)</option>
                                        <option value="UploadArquivo">Upload de Arquivo</option>
                                    </select>
                                </div>

                                <div class="mb-3 d-none" id="opcoesGrupo">
                                    <label class="form-label font-weight-semibold">Opções de Escolha (Separadas por Vírgula)</label>
                                    <input type="text" class="form-control" name="opcoesTexto" placeholder="Ex: Opção A, Opção B, Opção C" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label font-weight-semibold">Dica / Ajuda ao Usuário</label>
                                    <input type="text" class="form-control" name="dicaAjuda" placeholder="Ex: Digite apenas números inteiros." />
                                </div>

                                <div class="mb-3 form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="obrigatorio" value="true" id="obrigatorioCheck" />
                                    <label class="form-check-label font-weight-medium" for="obrigatorioCheck">Campo Obrigatório</label>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                                    <i class="bi bi-save"></i> Inserir Campo
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Preview / Listagem de Campos -->
                <div class="col-md-7">
                    <div class="card">
                        <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                            <span><i class="bi bi-eye-fill me-2 text-success"></i> Visualização Prévia (Renderização)</span>
                            <span class="badge bg-soft-primary bg-primary text-white">@Model.Nome</span>
                        </div>
                        <div class="card-body">
                            @if (!Model.Campos.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-view-list fs-1 mb-2"></i>
                                    <p>Nenhum campo estruturado para este formulário.</p>
                                </div>
                            }
                            else
                            {
                                <form onsubmit="return false;">
                                    @foreach (var campo in Model.Campos.OrderBy(c => c.Ordem))
                                    {
                                        <div class="mb-3">
                                            <label class="form-label font-weight-semibold">
                                                @campo.Rotulo
                                                @if (campo.Obrigatorio)
                                                {
                                                    <span class="text-danger">*</span>
                                                }
                                            </label>

                                            @if (campo.Tipo == TipoCampoFormulario.Texto)
                                            {
                                                <input type="text" class="form-control" placeholder="Entrada de texto..." />
                                            }
                                            else if (campo.Tipo == TipoCampoFormulario.AreaTexto)
                                            {
                                                <textarea class="form-control" rows="3" placeholder="Insira a descrição longa..."></textarea>
                                            }
                                            else if (campo.Tipo == TipoCampoFormulario.Numero)
                                            {
                                                <input type="number" class="form-control" placeholder="0" />
                                            }
                                            else if (campo.Tipo == TipoCampoFormulario.Moeda)
                                            {
                                                <div class="input-group">
                                                    <span class="input-group-text">R$</span>
                                                    <input type="number" step="0.01" class="form-control" placeholder="0,00" />
                                                </div>
                                            }
                                            else if (campo.Tipo == TipoCampoFormulario.Data)
                                            {
                                                <input type="date" class="form-control" />
                                            }
                                            else if (campo.Tipo == TipoCampoFormulario.Booleano)
                                            {
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" />
                                                    <label class="form-check-label text-muted">Marque esta opção</label>
                                                </div>
                                            }
                                            else if (campo.Tipo == TipoCampoFormulario.UploadArquivo)
                                            {
                                                <input type="file" class="form-control" />
                                            }
                                            else if (campo.Tipo == TipoCampoFormulario.Selecao || campo.Tipo == TipoCampoFormulario.SelecaoMultipla)
                                            {
                                                <select class="form-select" @(campo.Tipo == TipoCampoFormulario.SelecaoMultipla ? "multiple" : "")>
                                                    <option value="">Selecione...</option>
                                                    @foreach (var op in campo.Opcoes.OrderBy(o => o.Ordem))
                                                    {
                                                        <option value="@op.Valor">@op.TextoExibicao</option>
                                                    }
                                                </select>
                                            }


                                        </div>
                                    }
                                    <button class="btn btn-secondary w-100 rounded-pill mt-3 py-2 disabled" type="button">Submeter Teste</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Novo Form -->
<div class="modal fade" id="modalNovoForm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">Novo Formulário Dinâmico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Formularios/CriarNovo" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Nome do Formulário</label>
                        <input type="text" class="form-control" name="nome" required placeholder="Ex: Formulário de Contratação" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Descrição / Finalidade</label>
                        <textarea class="form-control" name="descricao" rows="3" placeholder="Descreva brevemente a finalidade deste formulário..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Criar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function alternarOpcoesSelect() {
            const selectTipo = document.getElementById('campoTipo');
            const opcoesGrupo = document.getElementById('opcoesGrupo');
            if (selectTipo.value === 'Selecao' || selectTipo.value === 'SelecaoMultipla') {
                opcoesGrupo.classList.remove('d-none');
            } else {
                opcoesGrupo.classList.add('d-none');
            }
        }
    </script>
}
